@prefix colibri: <https://colibri.example/ns/colibri#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

colibri: a owl:Ontology ;
  rdfs:label "The colibri vocabulary" ;
  rdfs:comment "RDFS-light vocabulary for the colibri knowledge graph: the Collibra operating model and, from Phase 2 on, the metaphactory ontology registry, joined by colibri:mapsTo." .

## Classes

colibri:AssetType a rdfs:Class ;
  rdfs:label "Asset type" ;
  rdfs:comment "A Collibra asset type. The class hierarchy (rdfs:subClassOf) mirrors the Collibra operating model." .

colibri:AttributeType a rdfs:Class ;
  rdfs:label "Attribute type" ;
  rdfs:comment "A Collibra attribute type, assigned to one or more asset types via colibri:assignedTo." .

colibri:RelationType a rdfs:Class ;
  rdfs:label "Relation type" ;
  rdfs:comment "A Collibra explicit relation type, with head asset type(s) (colibri:head) and tail asset type(s) (colibri:tail)." .

## Properties

colibri:provenance a rdf:Property ;
  rdfs:label "provenance" ;
  rdfs:comment "Where a node came from. Values: collibra-ootb (row in an OOTB reference table), collibra-ootb-breadcrumb (ancestry chain only), collibra-ootb-ref (referenced by another table, no row), metaphactory, mock (synthetic)." .

colibri:snapshot a rdf:Property ;
  rdfs:label "source snapshot" ;
  rdfs:comment "Path of the local documentation snapshot the node was transcribed from." .

colibri:product a rdf:Property ;
  rdfs:label "product" ;
  rdfs:comment "The Collibra product or module an asset type belongs to." .

colibri:kind a rdf:Property ;
  rdfs:label "attribute kind" ;
  rdfs:comment "Value kind of an attribute type (Text, Numeric, Date, True/False, Selection, Script)." .

colibri:coRole a rdf:Property ;
  rdfs:label "co-role" ;
  rdfs:comment "The reverse role name of a relation type (tail to head)." .

colibri:head a rdf:Property ;
  rdfs:label "head" ;
  rdfs:comment "Head asset type(s) of a relation type." ;
  rdfs:range colibri:AssetType .

colibri:tail a rdf:Property ;
  rdfs:label "tail" ;
  rdfs:comment "Tail asset type(s) of a relation type." ;
  rdfs:range colibri:AssetType .

colibri:assignedTo a rdf:Property ;
  rdfs:label "assigned to" ;
  rdfs:comment "Asset type(s) an attribute type is assigned to." ;
  rdfs:domain colibri:AttributeType ;
  rdfs:range colibri:AssetType .

colibri:unrestricted a rdf:Property ;
  rdfs:label "unrestricted" ;
  rdfs:comment "True when an attribute type is available on every asset type (shown as '-' or 'All' in the documentation). Such an attribute carries a single assignedTo edge to the synthetic Asset root, meaning 'all asset types'." .

colibri:unassigned a rdf:Property ;
  rdfs:label "unassigned" ;
  rdfs:comment "True when the documentation table never states which asset types the attribute type is assigned to (a documentation gap). The node carries a single assignedTo edge to the synthetic Asset root so it stays connected, but the assignment is explicitly unknown." .

colibri:possibleValue a rdf:Property ;
  rdfs:label "possible value" ;
  rdfs:comment "An enumerated value of a selection-style attribute type (e.g. the picklist values a field shows in Collibra)." .

colibri:mapsTo a rdf:Property ;
  rdfs:label "maps to" ;
  rdfs:comment "Reserved join property: connects a colibri node to the ontology entity it corresponds to in metaphactory. Populated in Phase 2; empty in Phase 1." .
