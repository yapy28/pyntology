@prefix py:      <https://colibri.example/ns/py#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://colibri.example/ns/py/execution> a owl:Ontology ;
  dcterms:title "py-execution: evaluation as events"@en ;
  owl:imports <https://colibri.example/ns/py/core> ,
              <https://colibri.example/ns/py/callable> ;
  rdfs:comment """Statements and expressions form a process ontology, disjoint from the
object model. Evaluation is not modeled step by step; what is modeled is
the SHAPE of evaluation: which expressions can raise which exceptions under
which conditions, and which names bind where (LEGB lexical scoping is one of
the few genuinely static facts in Python).

Events (an exception raised at a point in a frame) are reification-style
individuals: an event node that relates the exception, the raising
expression and the catching clause - the same semantics RDF 1.2 triple
terms express natively; stated as event nodes until tooling catches up."""@en .

py:raisesIn a rdf:Property ;
  rdfs:label "raises in"@en ;
  rdfs:comment "Relates a statement or expression to the exception it can raise during evaluation."@en .

py:bindsName a rdf:Property ;
  rdfs:label "binds name"@en ;
  rdfs:comment "Relates a statement to the name it binds in a frame; lexical (LEGB) scoping is one of the few genuinely static facts in Python."@en .

py:raisedFrom a rdf:Property ;
  rdfs:label "raised from"@en ;
  rdfs:comment "Chains an exception event to its causal origin (__cause__ / __context__)."@en .

py:caughtBy a rdf:Property ;
  rdfs:label "caught by"@en ;
  rdfs:comment "Relates an exception event to the except clause that can catch it, by subclass matching."@en .

py:ExceptionRaised a rdfs:Class ;
  rdfs:label "exception raised"@en ;
  rdfs:comment "An event: this exception, raised by this expression, possibly caught by this clause. A relation-about-relations - the reification-style form of what RDF 1.2 triple terms state natively."@en .
