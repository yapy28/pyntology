@prefix py:      <https://colibri.example/ns/py#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://colibri.example/ns/py/core> a owl:Ontology ;
  dcterms:title "py-core: the Python tower"@en ;
  rdfs:comment """The base ontology of Python itself. Python is a tower: values are
instances of types, types are instances of metatypes, and type is an
instance of itself - the fixed point. Single-level OWL reasoning (rdf:type)
cannot carry that tower, so it is represented as data: py:instanceOf is a
first-class relation at every level and py:towerLevel is materialized per
node. The class lattice uses the non-transitive __bases__ primitive
(py:subclassOf) plus the linearized search order as an ordered chain
(py:mroNext); transitive closures are materialized offline, never reasoned
at runtime."""@en .

## ---- The tower -----------------------------------------------------------

py:Object a rdfs:Class ;
  rdfs:label "object"@en ;
  rdfs:comment "The ontological reading of 'everything in Python is an object': every value, function, class and module is an object of some type."@en .

py:Value a rdfs:Class ;
  rdfs:label "value"@en ;
  rdfs:comment "A level-0 object: an actual piece of data such as 5, \"hello\" or None. Values are instances of types (level 1)."@en .

py:Type a rdfs:Class ;
  rdfs:label "type"@en ;
  rdfs:comment "A level-1 object: a class, such as int or str. Types create and describe values, and are themselves objects - instances of metatypes (level 2)."@en .

py:Metatype a rdfs:Class ;
  rdfs:label "metatype"@en ;
  rdfs:comment "A level-2 object: a type whose instances are types, such as type itself or ABCMeta. Metaclasses are metatypes with customization hooks (__new__, __init__, __call__)."@en .

py:Exception a rdfs:Class ;
  rdfs:label "exception"@en ;
  rdfs:comment "A type that can be raised: part of the subtree rooted at BaseException. Exceptions form a class lattice like any other types, plus a semantic taxonomy of failure conditions (see the python-conditions vocabulary)."@en .

py:Module a rdfs:Class ;
  rdfs:label "module"@en ;
  rdfs:comment "A level-0 object: an importable namespace of values, functions and classes. Modules are objects too (instances of types like module)."@en .

## ---- Tower and lattice relations ----------------------------------------

py:instanceOf a rdf:Property ;
  rdfs:label "instance of"@en ;
  rdfs:comment "The first-class instantiation relation, valid at every tower level: 5 instanceOf int, int instanceOf type, type instanceOf type (reflexive - the fixed point of the tower, stated as data rather than resolved as a paradox)."@en .

py:subclassOf a rdf:Property ;
  rdfs:label "subclass of"@en ;
  rdfs:comment "Direct superclass relation between types (the __bases__ primitive, deliberately NOT declared transitive: the transitive lattice is materialized separately because method resolution order is linearized and order matters)."@en .

py:mroNext a rdf:Property ;
  rdfs:label "next in MRO"@en ;
  rdfs:comment "One step along a type's method resolution order (__mro__): the linearized search order Python actually uses for attributes. Preserved as an ordered chain because it is exactly the data Python consults at runtime."@en .

py:metaclassOf a rdf:Property ;
  rdfs:label "metaclass of"@en ;
  rdfs:comment "Relates a class to the metaclass that constructed it. Distinct from py:instanceOf: they coincide only when no __class__ manipulation is in play; keeping both relations lets the graph state the difference where exotic Python lives (ABCs, Enums, metaclass conflicts)."@en .

py:towerLevel a rdf:Property ;
  rdfs:label "tower level"@en ;
  rdfs:comment "0 = value, 1 = type, 2 = metatype, 3 = type itself (the fixed point). Materialized per node so the tower can be seen directly, e.g. as depth in a 3D layout."@en .

## ---- Structure of a file --------------------------------------------------

py:definedIn a rdf:Property ;
  rdfs:label "defined in"@en ;
  rdfs:comment "Relates a definition (function, class, constant, module member) to the module whose body created it. A file is a module; what it defines hangs off it."@en .
